# Meshtastic Skill Configuration
# Copy to config.env and adjust paths

# Daemon data paths
MESH_INBOX=/tmp/mesh_inbox.txt
MESH_OUTBOX=/tmp/mesh_outbox.txt
MESH_POSITIONS=/tmp/mesh_positions.json
MESH_CONTEXT=/tmp/mesh_context.json
MESH_LOG=/tmp/mesh_daemon.log

# Your node ID
MESH_NODE_ID=!your_node_id

# Serial port (auto-detected if empty)
MESH_PORT=/dev/cu.usbmodem3101

# Channel index
MESH_CHANNEL=1

# Daemon process name (for health checks)
MESH_DAEMON_PROCESS=bridge.py
